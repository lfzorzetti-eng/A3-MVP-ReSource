  "politicas": [
    {
      "id": "p1",
      "titulo": "Política de destinação de resíduos perigosos",
      "texto": "Resíduos classe I (químicos, óleos, solventes) devem ser armazenados em área coberta com dreno de contenção, identificados com rótulo laranja e coletados exclusivamente por transportadora licenciada. Proibido descarte em aterro comum."
    },
    {
      "id": "p2",
      "titulo": "Meta Zero Waste 2027",
      "texto": "A empresa compromete-se a reduzir 15% a cada ano o volume de resíduos enviados a aterro, priorizando reuso interno, compostagem e reciclagem. Meta final: 85% de aproveitamento até 2027."
    },
    {
      "id": "p3",
      "titulo": "Boas práticas de separação na origem",
      "texto": "Todos os postos de trabalho possuem triagem em 4 categorias: plástico, papel, metal e orgânico. Resíduos perigosos seguem fluxo separado com ficha de movimentação obrigatória."
    },
    {
      "id": "p4",
      "titulo": "Fornecedor preferencial de destinação",
      "texto": "Priorizar parceiros com certificação ISO 14001. Para resíduos de alumínio e PET, usar sempre parceiros já homologados (MetalForte e ReciclaPlast) para manter rastreabilidade de laudos."
    }
  ],
