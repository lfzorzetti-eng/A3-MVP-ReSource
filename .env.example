# Copie este arquivo para .env e preencha com os seus valores.
# O .env está no .gitignore - nunca versione credenciais.

# --- Banco de dados -------------------------------------------------------
# MongoDB Atlas (cluster M0 free) ou um MongoDB local.
# Sem esta variável o app usa o banco simulado em data/db.json (dev local).
#   Atlas:  mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/
#   Local:  mongodb://localhost:27017
# Atenção: se a senha tiver caracteres especiais (< > : / @ etc.), ela precisa
# estar percent-encoded (%3C %3E ...).
MONGODB_URI=
MONGODB_DB=resource_mvp

# --- Agente de IA (Ollama) ------------------------------------------------
# Local:  OLLAMA_URL=http://localhost:11434  (sem OLLAMA_API_KEY)
#         OLLAMA_MODEL=llama3.2
# Cloud:  OLLAMA_URL=https://ollama.com      (com OLLAMA_API_KEY)
#         Modelos do plano FREE: gemma4:31b-cloud, gpt-oss:120b, gpt-oss:20b
#         (llama3.2 não existe no cloud; deepseek-v4.1-flash e glm-5.3-flash são do Pro)
OLLAMA_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=

# --- Segurança ------------------------------------------------------------
# Se definido, POST /api/reset exige o header x-admin-token com este valor.
# Gere um forte com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# --- Rate limit (por IP, por minuto) --------------------------------------
RATE_LIMIT=on
RATE_LIMIT_CHAT=20
RATE_LIMIT_ANALISE=10

# --- Servidor local -------------------------------------------------------
PORT=3000
