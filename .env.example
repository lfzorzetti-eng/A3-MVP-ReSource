# ============================================================================
# ReSource MVP — exemplo de variáveis de ambiente
# Copie para .env e preencha os valores reais. NUNCA versione o .env.
# ============================================================================

# --- Banco de dados ---------------------------------------------------------
# MongoDB Atlas (produção). Sem esta variável, a API usa data/db.json em modo
# simulado — útil para desenvolvimento local sem internet.
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=resource_mvp

# --- Agente de IA -----------------------------------------------------------
# Ollama Cloud:
OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b-cloud

# Ollama local (alternativa):
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Sessões da demonstração ------------------------------------------------
# Segredo usado para assinar o token de sessão (HMAC).
# Se vazio, a API usa ADMIN_TOKEN como fallback.
SESSION_SECRET=troque-por-um-segredo-forte
SESSION_TTL_HOURS=12

# --- Segurança / operação ---------------------------------------------------
# POST /api/reset exige o header x-admin-token com este valor.
ADMIN_TOKEN=

# Rate limit por IP (por minuto). RATE_LIMIT=off desativa.
RATE_LIMIT=on
RATE_LIMIT_CHAT=20
RATE_LIMIT_ANALISE=10
RATE_LIMIT_LOGIN=20

# --- Servidor local ---------------------------------------------------------
PORT=3000
